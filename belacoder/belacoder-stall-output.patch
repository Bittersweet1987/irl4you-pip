   if (GST_IS_ELEMENT(srt_app_sink)) {
     gst_app_sink_set_callbacks (GST_APP_SINK(srt_app_sink), &callbacks, NULL, NULL);
+    stall_sink = srt_app_sink;   // IRL4YOU: the output, see stall_check()
     srt_host = argv[optind+1];
