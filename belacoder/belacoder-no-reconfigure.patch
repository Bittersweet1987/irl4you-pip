+    if (g_getenv("SB_FEED_RECONFIGURE") == NULL || g_strcmp0(g_getenv("SB_FEED_RECONFIGURE"), "0") != 0) feed_block_reconfigure(fd);
     feed_frame_copy(fd);
     fd->active = TRUE;
