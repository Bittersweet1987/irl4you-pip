+static void feed_link_pad(GstElement *demux, GstPad *pad, gpointer data) {
+  Feed *fd = (Feed *)data;
+  if (gst_pad_is_linked(pad)) return;        // the parser linked it
+  gchar *pname = gst_pad_get_name(pad);
+  const char *kind = strncmp(pname, "video", 5) == 0 ? "vq" : (strncmp(pname, "audio", 5) == 0 ? "aq" : NULL);
+  if (kind) {
+    char ename[48];
+    snprintf(ename, sizeof(ename), "%s_%s", fd->name, kind);
