+  // what the controller did (counted since the last statistics line) and the sent rate behind the cap, bit/s
+  unsigned n_cap, n_th3, n_d2, n_d1, n_up;
+  double sent_fast, sent_slow, sent_fast_min;
+  int cap;
+} ctl;
