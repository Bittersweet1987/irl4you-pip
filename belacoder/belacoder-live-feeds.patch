+static guint64 cnt_enc_in = 0, cnt_enc_out = 0, cnt_enc_bytes = 0, cnt_comp_out = 0, cnt_comp_new = 0;
+#define STAT_PROBES 32   // 16 were not enough: the demux of the main video got none when the drone's came first (no dmx_m in the report)
+typedef struct {
+  char name[16];
+  guint64 count;       // buffers seen
+  guint64 last;        // count at the previous statistics line
+  gint64 last_us;      // time of the previous buffer
+  guint64 bursts;      // buffers that came less than 8 ms after the previous one (in this interval)
+  gint64 maxgap_us;    // longest pause between two buffers (in this interval)
+  GstClock *clock;     // for the lag of the buffers behind the pipeline clock
+  GstClockTime base;
+  GstSegment segment;
+  gboolean have_segment;
+  guint32 seg_seqnum;  // the segment changes when a feed comes back
+  gint64 lag_min_us, lag_max_us, lag_sum_us, lag_n;
+} Probe;
+static Probe probes[STAT_PROBES];
+static int n_probes = 0;
+static struct {
