+    GstElement *q = gst_bin_get_by_name(GST_BIN(gst_pipeline), qn);
+    if (!q) continue;
+    GstPad *qs = gst_element_get_static_pad(q, "src");
+    if (qs) {
+      tails[i] = gst_pad_get_peer(qs);
+      if (tails[i]) gst_pad_push_event(qs, gst_event_new_flush_start());
+      gst_object_unref(qs);
+    }
+    gst_object_unref(q);
+  }
+  if (fd->src) feed_null(fd->src);
+  for (GList *l = fd->elems; l; l = l->next) {
+    if (l->data != fd->src) feed_null(GST_ELEMENT(l->data));
+  }
+  for (int i = 0; i < 2; i++) {
+    if (!tails[i]) continue;
+    gst_pad_send_event(tails[i], gst_event_new_flush_stop(TRUE));
+    gst_object_unref(tails[i]);
+  }
+
+  g_mutex_lock(&fd->lock);
+  if (fd->vpad) { gst_object_unref(fd->vpad); fd->vpad = NULL; }
+  if (fd->apad) { gst_object_unref(fd->apad); fd->apad = NULL; }
+  fd->aligned = FALSE;
+  fd->offset = 0;
+  g_mutex_unlock(&fd->lock);
+}
+
+static void feed_start(Feed *fd) {
+  if (!fd->dynamic || fd->active) return;
+  fd->active = TRUE;
+  fprintf(stderr, "Feed %s started\n", fd->name);
+  for (GList *l = fd->elems; l; l = l->next) {
+    GstElement *el = GST_ELEMENT(l->data);
+    if (el == fd->src) continue;
+    gst_element_set_locked_state(el, FALSE);
+    gst_element_sync_state_with_parent(el);
+  }
+  gst_element_set_locked_state(fd->src, FALSE);
+  gst_element_sync_state_with_parent(fd->src);
+}
+
+// sb11: the compositor asks every pad for its latency. A branch that is stopped (its elements are in the NULL state) cannot answer, the query fails,
+// the compositor gives up its live mode and then waits for every camera pad: one camera that stalls (or has not started) slows the whole output down
+// (3 - 6 frames per second, for seconds). The last queue of every branch answers the latency query itself: live, no minimum, no maximum.
+static GstPadProbeReturn feed_latency_probe(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  GstQuery *q = GST_PAD_PROBE_INFO_QUERY(info);
+  if (q && GST_QUERY_TYPE(q) == GST_QUERY_LATENCY) {
+    gst_query_set_latency(q, TRUE, 0, GST_CLOCK_TIME_NONE);
+    return GST_PAD_PROBE_HANDLED;
+  }
+  return GST_PAD_PROBE_OK;
+}
+
+static void feed_answer_latency(Feed *fd) {
+  if (!fd->extra[0]) return;
+  GstElement *q = gst_bin_get_by_name(GST_BIN(gst_pipeline), fd->extra[0]);
+  if (!q) return;
+  GstPad *src = gst_element_get_static_pad(q, "src");
+  if (src) {
+    gst_pad_add_probe(src, GST_PAD_PROBE_TYPE_QUERY_UPSTREAM, feed_latency_probe, NULL, NULL);
+    gst_object_unref(src);
+  }
+  gst_object_unref(q);
+}
+
+static void setup_feeds(const char *absent) {
+  for (unsigned i = 0; i < sizeof(align_feeds) / sizeof(align_feeds[0]); i++) {
+    Feed *fd = &align_feeds[i];
+    char sname[48];
+    snprintf(sname, sizeof(sname), "%s_src", fd->name);
+    fd->src = gst_bin_get_by_name(GST_BIN(gst_pipeline), sname);
+    if (!fd->src) continue;
+    GstIterator *it = gst_bin_iterate_elements(GST_BIN(gst_pipeline));
+    GValue v = G_VALUE_INIT;
+    gboolean done = FALSE;
+    while (!done) {
+      switch (gst_iterator_next(it, &v)) {
+        case GST_ITERATOR_OK: {
+          GstElement *el = GST_ELEMENT(g_value_get_object(&v));
+          gchar *name = gst_element_get_name(el);
+          if (name && feed_has_element(fd, name)) fd->elems = g_list_prepend(fd->elems, gst_object_ref(el));
+          g_free(name);
+          g_value_reset(&v);
+          break;
+        }
+        case GST_ITERATOR_RESYNC:
+          g_list_free_full(fd->elems, gst_object_unref);
+          fd->elems = NULL;
+          gst_iterator_resync(it);
+          break;
+        default:
+          done = TRUE;
+          break;
+      }
+    }
+    g_value_unset(&v);
+    gst_iterator_free(it);
+    fd->dynamic = TRUE;
+    if (g_getenv("SB_FEED_LATENCY") == NULL || g_strcmp0(g_getenv("SB_FEED_LATENCY"), "0") != 0) feed_answer_latency(fd);
+    fd->active = TRUE;
+    GstElement *demux = gst_bin_get_by_name(GST_BIN(gst_pipeline), fd->name);
+    if (demux) {
+      g_signal_connect(demux, "pad-added", G_CALLBACK(feed_link_pad), fd);
+      gst_object_unref(demux);
+    }
+    if (absent && strstr(absent, fd->name)) {
+      fd->active = FALSE;
+      for (GList *l = fd->elems; l; l = l->next) gst_element_set_locked_state(GST_ELEMENT(l->data), TRUE);
+      fprintf(stderr, "Feed %s is not there at the start\n", fd->name);
+    }
+    fprintf(stderr, "Dynamic feed %s: %u elements\n", fd->name, g_list_length(fd->elems));
+  }
+}
+
+static void apply_control_line(char *line) {
+  char cmd[16], elem_name[64], a[64], b[64], value[256];
+  value[0] = 0;
+
+  if (sscanf(line, "%15s", cmd) != 1) return;
+
+  GstElement *elem = NULL;
+  if (strcmp(cmd, "set") == 0) {
+    if (sscanf(line, "%*s %63s %63s %255[^\n]", elem_name, a, value) < 3) return;
+    elem = gst_bin_get_by_name(GST_BIN(gst_pipeline), elem_name);
+    if (!elem) { fprintf(stderr, "control: no element %s\n", elem_name); return; }
+    gst_util_set_object_arg(G_OBJECT(elem), a, value);
+    gst_object_unref(elem);
+  } else if (strcmp(cmd, "pad") == 0) {
+    if (sscanf(line, "%*s %63s %63s %63s %255[^\n]", elem_name, a, b, value) < 4) return;
+    elem = gst_bin_get_by_name(GST_BIN(gst_pipeline), elem_name);
+    if (!elem) { fprintf(stderr, "control: no element %s\n", elem_name); return; }
+    GstPad *pad = find_pad_by_name(elem, a);
+    if (pad) {
+      gst_util_set_object_arg(G_OBJECT(pad), b, value);
+      gst_object_unref(pad);
+    } else {
+      fprintf(stderr, "control: no pad %s on %s\n", a, elem_name);
+    }
+    gst_object_unref(elem);
+  } else if (strcmp(cmd, "feed") == 0) {
+    char onoff[8];
+    if (sscanf(line, "%*s %63s %7s", elem_name, onoff) < 2) return;
+    Feed *fd = feed_by_name(elem_name);
+    if (!fd) { fprintf(stderr, "control: no dynamic feed %s\n", elem_name); return; }
+    if (strcmp(onoff, "on") == 0) feed_start(fd);
+    else if (strcmp(onoff, "off") == 0) feed_stop(fd, "switched off");
+  } else if (strcmp(cmd, "select") == 0) {
+    if (sscanf(line, "%*s %63s %63s", elem_name, a) < 2) return;
+    elem = gst_bin_get_by_name(GST_BIN(gst_pipeline), elem_name);
+    if (!elem) { fprintf(stderr, "control: no element %s\n", elem_name); return; }
+    GstPad *pad = find_pad_by_name(elem, a);
+    if (pad) {
+      g_object_set(G_OBJECT(elem), "active-pad", pad, NULL);
+      gst_object_unref(pad);
+    } else {
+      fprintf(stderr, "control: no pad %s on %s\n", a, elem_name);
+    }
+    gst_object_unref(elem);
+  }
+}
+
+static gboolean control_cb(gint fd, GIOCondition cond, gpointer data) {
+  static char buf[4096];
+  static size_t used = 0;
+
+  ssize_t n = read(fd, buf + used, sizeof(buf) - used - 1);
+  if (n <= 0) return TRUE;
+  used += n;
+  buf[used] = 0;
+
+  char *start = buf;
+  char *nl;
+  while ((nl = strchr(start, '\n')) != NULL) {
+    *nl = 0;
+    apply_control_line(start);
+    start = nl + 1;
+  }
+  used = strlen(start);
+  memmove(buf, start, used + 1);
+  if (used >= sizeof(buf) - 1) used = 0; // overlong line without a newline, drop it
+  return TRUE;
+}
+
+static void setup_control(void) {
+  if (!control_path) return;
+  mkfifo(control_path, 0600);  // fine if it exists already
+  // O_RDWR: never sees EOF when a writer closes, and open() does not block
+  control_fd = open(control_path, O_RDWR | O_NONBLOCK);
+  if (control_fd < 0) {
+    fprintf(stderr, "Failed to open the control fifo %s: ", control_path);
+    perror("");
+    return;
+  }
+  g_unix_fd_add(control_fd, G_IO_IN, control_cb, NULL);
+  fprintf(stderr, "Control fifo: %s\n", control_path);
+}
