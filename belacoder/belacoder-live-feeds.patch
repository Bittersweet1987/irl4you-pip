+                                    {"in_f0", "sbf0_q"}, {"in_f1", "sbf1_q"}, {"in_f2", "sbf2_q"}, {"in_f3", "sbf3_q"}};
+  for (unsigned i = 0; i < sizeof(queues) / sizeof(queues[0]); i++) {
+    e = gst_bin_get_by_name(GST_BIN(pipeline), queues[i][1]);
