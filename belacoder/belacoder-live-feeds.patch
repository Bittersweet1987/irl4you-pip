+/*
+  streamingbox extension: live control of the running pipeline (-C <fifo>)
+
+  Lines written to the FIFO change properties while the stream keeps running, e.g. to move or hide a
+  picture-in-picture without restarting belacoder (which would interrupt the stream):
+
+    set    <element> <property> <value>            element property
+    pad    <element> <pad> <property> <value>      property of a pad, e.g. a compositor sink pad
+    select <element> <pad>                         make <pad> the active pad of an input-selector
+
+  The value is converted like in gst-launch (numbers, booleans, enum names).
+*/
+static char *control_path = NULL;
+static int control_fd = -1;
+
+static GstPad *find_pad_by_name(GstElement *elem, const char *name) {
+  GstPad *found = NULL;
+  GstIterator *it = gst_element_iterate_pads(elem);
+  GValue v = G_VALUE_INIT;
+  gboolean done = FALSE;
+
+  while (!done) {
+    switch (gst_iterator_next(it, &v)) {
+      case GST_ITERATOR_OK: {
+        GstPad *pad = GST_PAD(g_value_get_object(&v));
+        gchar *pad_name = gst_pad_get_name(pad);
+        if (strcmp(pad_name, name) == 0) {
+          found = gst_object_ref(pad);
+          done = TRUE;
+        }
+        g_free(pad_name);
+        g_value_reset(&v);
+        break;
+      }
+      case GST_ITERATOR_RESYNC:
+        gst_iterator_resync(it);
+        break;
+      default:
+        done = TRUE;
+        break;
+    }
+  }
+  g_value_unset(&v);
+  gst_iterator_free(it);
+  return found;
+}
