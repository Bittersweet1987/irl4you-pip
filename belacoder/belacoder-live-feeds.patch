+        } else if (name && (strcmp(name, "sbpd_vr") == 0 || strcmp(name, "sbdd_vr") == 0)) {
+          add_counter(name[2] == 'p' ? "vr_p" : "vr_d", el, "src");
+        } else if (name && strncmp(name, "sbf", 3) == 0 && name[3] >= '0' && name[3] <= '7' && strcmp(name + 4, "_dec") == 0) {
+          char label[16];
+          snprintf(label, sizeof(label), "dec_f%c", name[3]);
+          add_counter(label, el, "src");
+        } else if (name && strncmp(name, "sbf", 3) == 0 && name[3] >= '0' && name[3] <= '7' && strcmp(name + 4, "_vr") == 0) {
