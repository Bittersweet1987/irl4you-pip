+  GValue v = G_VALUE_INIT;
+  gboolean done = FALSE;
+  while (!done) {
+    switch (gst_iterator_next(it, &v)) {
+      case GST_ITERATOR_OK: {
+        GstElement *el = GST_ELEMENT(g_value_get_object(&v));
+        gchar *name = gst_element_get_name(el);
+        if (name && strncmp(name, "mppvideodec", 11) == 0) {
+          char label[16];
+          snprintf(label, sizeof(label), "dec%s", name + 11);
+          add_counter(label, el, "src");
+        } else if (name && strncmp(name, "videorate", 9) == 0) {
+          char label[16];
+          snprintf(label, sizeof(label), "vr%s", name + 9);
