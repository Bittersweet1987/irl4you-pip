+  // and what it did in this second: cap = bitrate lowered to the cap, th3 = back to the minimum, d2 / d1 = two kinds of decrease, up = increase
+  fprintf(f, " cap=%d sf=%.0f ss=%.0f sf_min=%.0f n_cap=%u n_th3=%u n_d2=%u n_d1=%u n_up=%u", ctl.cap / 1000, ctl.sent_fast / 1000.0,
+          ctl.sent_slow / 1000.0, ctl.sent_fast_min < 0 ? 0.0 : ctl.sent_fast_min / 1000.0, ctl.n_cap, ctl.n_th3, ctl.n_d2, ctl.n_d1, ctl.n_up);
+  ctl.n_cap = ctl.n_th3 = ctl.n_d2 = ctl.n_d1 = ctl.n_up = 0;
+  ctl.sent_fast_min = -1;
+  for (int i = 0; i < n_probes; i++) {
+    guint64 c = __atomic_load_n(&probes[i].count, __ATOMIC_RELAXED);
+    guint64 b = __atomic_exchange_n(&probes[i].bursts, 0, __ATOMIC_RELAXED);
+    gint64 g = __atomic_exchange_n(&probes[i].maxgap_us, 0, __ATOMIC_RELAXED);
+    // fps, buffers that came in a burst (<8 ms after the previous one), longest pause in ms
+    fprintf(f, " %s=%.1f/%llu/%lld", probes[i].name, (c - probes[i].last) * k, (unsigned long long)b, (long long)(g / 1000));
+    probes[i].last = c;
+    if (probes[i].lag_n > 0) {
+      // how late (+) or early (-) the buffers are compared with the pipeline clock: min / mean / max in ms
+      fprintf(f, " %s_lag=%lld/%lld/%lld", probes[i].name, (long long)(probes[i].lag_min_us / 1000),
+              (long long)(probes[i].lag_sum_us / probes[i].lag_n / 1000), (long long)(probes[i].lag_max_us / 1000));
+      probes[i].lag_n = 0;
+      probes[i].lag_sum_us = 0;
+    }
+  }
+  {
+    int fp = feed_state_of("sbpd"), fdr = feed_state_of("sbdd");
+    if (fp) fprintf(f, " feed_p=%d", fp);
+    if (fdr) fprintf(f, " feed_d=%d", fdr);
+    // sb10: feed_sbf<N>=<1|2|3> for every dynamic feed named sbf<N> (1 stopped, 2 running without picture, 3 pictures arrive)
+    for (char c = '0'; c <= '7'; c++) {
+      char nm[8];
