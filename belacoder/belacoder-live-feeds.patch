+static int n_log = 0;
+static GMutex log_lock;
+
+static void sb_log_fn(GstDebugCategory *cat, GstDebugLevel level, const gchar *file, const gchar *function,
+                      gint line, GObject *object, GstDebugMessage *message, gpointer user_data) {
+  if (level > GST_LEVEL_WARNING) return;
+  const char *cname = cat ? gst_debug_category_get_name(cat) : "?";
+  const gchar *text = gst_debug_message_get(message);
+  // counted per category and element: "mppdec/mppvideodec1"
+  char key[sizeof(logtab[0].cat)];
+  const char *oname = (object && GST_IS_OBJECT(object)) ? GST_OBJECT_NAME(object) : NULL;
+  snprintf(key, sizeof(key), "%s%s%s", cname, oname ? "/" : "", oname ? oname : "");
+
+  g_mutex_lock(&log_lock);
+  int i;
+  for (i = 0; i < n_log; i++) {
+    if (strcmp(logtab[i].cat, key) == 0) break;
+  }
+  if (i == n_log) {
+    if (n_log < LOG_ENTRIES) {
+      n_log++;
+      snprintf(logtab[i].cat, sizeof(logtab[i].cat), "%s", key);
+      logtab[i].count = 0;
+      logtab[i].last_count = 0;
+    } else {
+      i = LOG_ENTRIES - 1;
+    }
+  }
+  logtab[i].count++;
+  snprintf(logtab[i].msg, sizeof(logtab[i].msg), "%s%s: %s", level == GST_LEVEL_ERROR ? "ERROR " : "",
+           function ? function : "", text ? text : "");
+  for (char *c = logtab[i].msg; *c; c++) {
+    if (*c == '\n' || *c == '\r') *c = ' ';
+  }
+  g_mutex_unlock(&log_lock);
+}
