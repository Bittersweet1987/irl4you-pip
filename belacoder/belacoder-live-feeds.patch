+// the compositor pad that is fed by the last queue of the branch
+static GstPad *feed_comp_pad(Feed *fd) {
+  GstElement *q = gst_bin_get_by_name(GST_BIN(gst_pipeline), fd->extra[0]);
+  if (!q) return NULL;
+  GstPad *src, *peer = NULL;
+  if (feed_pad_of(q, "src", &src)) {
+    peer = gst_pad_get_peer(src);
+    gst_object_unref(src);
+  }
+  gst_object_unref(q);
+  return peer;
+}
