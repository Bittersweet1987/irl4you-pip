+/*
+  streamingbox extension: align the RTMP inputs to the pipeline clock (-A <ms>)
+
+  The pictures that are mixed by the compositor come from RTMP feeds (rtmpsrc ! flvdemux): their timestamps start at
+  zero when the feed is joined, but the pipeline clock has been running for a while (connect, waiting for the next
+  keyframe, decoder start: 0.5 .. 2 s, different at every start). The compositor works on the pipeline clock, so
+  every frame arrives "late", it drops the old frames and repeats the last one: the picture stutters, only a few
+  frames per second are new, and the encoder (fed with repeated frames) produces a fraction of the bitrate.
+
+  On the first video buffer of a feed the offset between its timestamps and the pipeline clock is measured, and the
+  src pads of its flvdemux (video and audio, so they stay in sync) are shifted by it plus <ms>, which is the time
+  the frames get to arrive (a jitter buffer). From then on a frame is due when it arrives, <ms> later.
+*/
+static int align_ms = 0;
+typedef struct {
+  const char *name;      // name of the flvdemux
+  GstPad *vpad, *apad;
+  gboolean aligned;
+  gint64 offset;         // ns, applied to the src pads of the flvdemux
+  GMutex lock;
+  GstClock *clock;
+  GstClockTime base;
+  // dynamic feeds (sb4): the branch of a feed can be stopped and started again while the rest keeps running
+  const char *extra[3];  // more elements that belong to the branch (their names are fixed, the control commands use them)
+  gboolean dynamic;      // the branch has a source element called <name>_src
+  gboolean active;       // branch running
+  GList *elems;          // all elements of the branch
+  GstElement *src;
+} Feed;
+// sb10: any number of feeds named sbf0 .. sbf7 (IRL4YOU BOX): every element of such a branch is called sbf<N>_..., the last video queue
+// sbf<N>_q (its src pad feeds the compositor), the end of the audio chain sbf<N>_aq2. sbpd / sbdd stay for streamingbox.
+static Feed align_feeds[] = {{.name = "demux"},
+                             {.name = "sbpd", .extra = {"sbqp", "sbscp", "sbcrp"}},
+                             {.name = "sbdd", .extra = {"sbqd", "sbscd", "sbcrd"}},
+                             {.name = "sbf0", .extra = {"sbf0_q"}}, {.name = "sbf1", .extra = {"sbf1_q"}},
+                             {.name = "sbf2", .extra = {"sbf2_q"}}, {.name = "sbf3", .extra = {"sbf3_q"}},
+                             {.name = "sbf4", .extra = {"sbf4_q"}}, {.name = "sbf5", .extra = {"sbf5_q"}},
+                             {.name = "sbf6", .extra = {"sbf6_q"}}, {.name = "sbf7", .extra = {"sbf7_q"}}};
+// 0 = no such feed / not dynamic, 1 = branch stopped, 2 = running, waiting for the first picture, 3 = pictures arrive
+static int feed_state_of(const char *name) {
+  for (unsigned i = 0; i < sizeof(align_feeds) / sizeof(align_feeds[0]); i++) {
+    Feed *fd = &align_feeds[i];
+    if (strcmp(fd->name, name) != 0 || !fd->dynamic) continue;
+    return !fd->active ? 1 : (fd->aligned ? 3 : 2);
+  }
+  return 0;
+}
+
+static void feed_apply_offset(Feed *fd) {
+  if (fd->vpad) gst_pad_set_offset(fd->vpad, fd->offset);
+  if (fd->apad) gst_pad_set_offset(fd->apad, fd->offset);
+}
+
+static gboolean feed_now(Feed *fd, GstPad *pad, GstClockTime *now) {
+  if (!fd->clock) {
+    GstElement *par = gst_pad_get_parent_element(pad);
+    if (!par) return FALSE;
+    fd->clock = gst_element_get_clock(par);
+    fd->base = gst_element_get_base_time(par);
+    gst_object_unref(par);
+    if (!fd->clock) return FALSE;
+  }
+  *now = gst_clock_get_time(fd->clock) - fd->base;
+  return TRUE;
+}
+
+// running time of the buffer on this pad (without the offset that streamingbox adds below the flvdemux)
+static GstClockTime pad_buffer_rt(GstPad *pad, GstBuffer *b) {
+  GstClockTime ts = GST_BUFFER_PTS_IS_VALID(b) ? GST_BUFFER_PTS(b) : GST_BUFFER_DTS(b);
+  if (!GST_CLOCK_TIME_IS_VALID(ts)) return GST_CLOCK_TIME_NONE;
+  GstEvent *ev = gst_pad_get_sticky_event(pad, GST_EVENT_SEGMENT, 0);
+  if (!ev) return GST_CLOCK_TIME_NONE;
+  const GstSegment *seg;
+  gst_event_parse_segment(ev, &seg);
+  GstClockTime rt = (seg->format == GST_FORMAT_TIME) ? gst_segment_to_running_time(seg, GST_FORMAT_TIME, ts) : GST_CLOCK_TIME_NONE;
+  gst_event_unref(ev);
+  return rt;
+}
+
+// first video buffer of the feed: measure how far it is behind the pipeline clock and shift the feed by it
+static GstPadProbeReturn probe_align(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  Feed *fd = (Feed *)data;
+  if (fd->aligned || !(info->type & GST_PAD_PROBE_TYPE_BUFFER)) return GST_PAD_PROBE_OK;
+  GstClockTime rt = pad_buffer_rt(pad, GST_PAD_PROBE_INFO_BUFFER(info));
+  GstClockTime now;
+  g_mutex_lock(&fd->lock);
+  if (!GST_CLOCK_TIME_IS_VALID(rt) || !feed_now(fd, pad, &now)) {
+    g_mutex_unlock(&fd->lock);
+    return GST_PAD_PROBE_OK;
+  }
+  if (!fd->aligned) {
+    fd->offset = (gint64)now - (gint64)rt + (gint64)align_ms * 1000000;
+    if (fd->offset < 0) fd->offset = 0;
+    feed_apply_offset(fd);
+    fd->aligned = TRUE;
+    fprintf(stderr, "Aligned %s to the pipeline clock: offset %lld ms (incl. %d ms buffer)\n", fd->name,
+            (long long)(fd->offset / 1000000), align_ms);
+  }
+  g_mutex_unlock(&fd->lock);
+  return GST_PAD_PROBE_REMOVE;
+}
+
+static void feed_pad_added(GstElement *demux, GstPad *pad, gpointer data) {
+  Feed *fd = (Feed *)data;
+  gchar *name = gst_pad_get_name(pad);
+  g_mutex_lock(&fd->lock);
+  if (strncmp(name, "video", 5) == 0) {
+    fd->vpad = gst_object_ref(pad);
+    gst_pad_add_probe(pad, GST_PAD_PROBE_TYPE_BUFFER, probe_align, fd, NULL);
+  } else if (strncmp(name, "audio", 5) == 0) {
+    fd->apad = gst_object_ref(pad);
+    if (fd->aligned) gst_pad_set_offset(pad, fd->offset);   // the audio pad came after the first video buffer
+  }
+  g_mutex_unlock(&fd->lock);
+  g_free(name);
+}
+
+static void setup_align(GstElement *pipeline) {
+  if (align_ms <= 0) return;
+  // only a pipeline with a compositor needs it
+  GstElement *comp = gst_bin_get_by_name(GST_BIN(pipeline), "pipcomp");
+  if (!comp) return;
+  gst_object_unref(comp);
+  for (unsigned i = 0; i < sizeof(align_feeds) / sizeof(align_feeds[0]); i++) {
+    GstElement *demux = gst_bin_get_by_name(GST_BIN(pipeline), align_feeds[i].name);
+    if (!demux) continue;
+    g_signal_connect(demux, "pad-added", G_CALLBACK(feed_pad_added), &align_feeds[i]);
+    gst_object_unref(demux);
+  }
+  fprintf(stderr, "Aligning the RTMP inputs to the pipeline clock, buffer %d ms\n", align_ms);
+}
+
+// the video pad of a flvdemux appears when the stream starts
+static void stats_pad_added(GstElement *demux, GstPad *pad, gpointer label) {
+  gchar *name = gst_pad_get_name(pad);
+  if (strncmp(name, "video", 5) == 0) {
+    // a feed that comes back gets a new pad: keep the slot of its label
+    int slot = -1;
+    for (int i = 0; i < n_probes; i++) {
+      if (strcmp(probes[i].name, (const char *)label) == 0) slot = i;
+    }
+    if (slot < 0 && n_probes < STAT_PROBES) {
+      slot = n_probes++;
+      snprintf(probes[slot].name, sizeof(probes[slot].name), "%s", (const char *)label);
+    }
+    if (slot >= 0) {
+      probes[slot].have_segment = FALSE;
+      add_probe(demux, name, probe_timed, &probes[slot]);
+    }
+  }
+  g_free(name);
+}
+
+static void setup_stats(GstElement *pipeline) {
+  if (!stats_path) return;
+
+  static const char *demuxes[][2] = {{"dmx_m", "demux"}, {"dmx_p", "sbpd"}, {"dmx_d", "sbdd"},
+                                     {"dmx_f0", "sbf0"}, {"dmx_f1", "sbf1"}, {"dmx_f2", "sbf2"}, {"dmx_f3", "sbf3"}};
+  for (unsigned i = 0; i < sizeof(demuxes) / sizeof(demuxes[0]); i++) {
+    GstElement *dm = gst_bin_get_by_name(GST_BIN(pipeline), demuxes[i][1]);
+    if (dm) {
+      g_signal_connect(dm, "pad-added", G_CALLBACK(stats_pad_added), (gpointer)demuxes[i][0]);
+      gst_object_unref(dm);
+    }
+  }
+
+  GstElement *e = gst_bin_get_by_name(GST_BIN(pipeline), "pipcomp");
+  if (e) {
+    add_probe(e, "src", probe_count, &cnt_comp_out);
+    add_probe(e, "src", probe_comp_new, NULL);
+    add_counter("comp", e, "src");
+    gst_object_unref(e);
+  }
+  if (GST_IS_ELEMENT(encoder)) {
+    add_probe(encoder, "sink", probe_count, &cnt_enc_in);
+    add_probe(encoder, "src", probe_enc_out, NULL);
+  }
+  // the last queue of every picture before the compositor (named by streamingbox)
+  static const char *queues[][2] = {{"in_main", "sbqm"}, {"in_pip", "sbqp"}, {"in_drone", "sbqd"},
