+static GstPadProbeReturn probe_count(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  guint64 n = 1;
+  if (info->type & GST_PAD_PROBE_TYPE_BUFFER_LIST) {
+    n = gst_buffer_list_length(GST_PAD_PROBE_INFO_BUFFER_LIST(info));
+  }
+  __atomic_fetch_add((guint64 *)data, n, __ATOMIC_RELAXED);
+  return GST_PAD_PROBE_OK;
+}
+
+static GstPadProbeReturn probe_timed(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  Probe *pr = (Probe *)data;
+  gint64 now = g_get_monotonic_time();
+  // how far behind the pipeline clock is the running time of this buffer? (positive: late)
+  if (info->type & GST_PAD_PROBE_TYPE_BUFFER) {
+    GstBuffer *b = GST_PAD_PROBE_INFO_BUFFER(info);
+    GstEvent *ev = gst_pad_get_sticky_event(pad, GST_EVENT_SEGMENT, 0);
+    if (ev) {
+      const GstSegment *seg;
+      gst_event_parse_segment(ev, &seg);
+      if (!pr->have_segment || gst_event_get_seqnum(ev) != pr->seg_seqnum || seg->base != pr->segment.base) {
+        if (seg->format == GST_FORMAT_TIME) {
+          gst_segment_copy_into(seg, &pr->segment);
+          pr->seg_seqnum = gst_event_get_seqnum(ev);
+          pr->have_segment = TRUE;
+        }
+      }
+      gst_event_unref(ev);
+    }
+    if (!pr->clock) {
+      GstElement *par = gst_pad_get_parent_element(pad);
+      if (par) {
+        pr->clock = gst_element_get_clock(par);
+        pr->base = gst_element_get_base_time(par);
+        gst_object_unref(par);
+      }
+    }
+    if (pr->have_segment && pr->clock && GST_BUFFER_PTS_IS_VALID(b)) {
+      GstClockTime rt = gst_segment_to_running_time(&pr->segment, GST_FORMAT_TIME, GST_BUFFER_PTS(b));
+      GstClockTime nowrt = gst_clock_get_time(pr->clock) - pr->base;
+      if (GST_CLOCK_TIME_IS_VALID(rt)) {
+        gint64 lag = ((gint64)nowrt - (gint64)rt) / 1000;
+        if (pr->lag_n == 0 || lag < pr->lag_min_us) pr->lag_min_us = lag;
+        if (pr->lag_n == 0 || lag > pr->lag_max_us) pr->lag_max_us = lag;
+        pr->lag_sum_us += lag;
+        pr->lag_n++;
+      }
+    }
+  }
+  gint64 prev = __atomic_exchange_n(&pr->last_us, now, __ATOMIC_RELAXED);
+  if (prev) {
+    gint64 gap = now - prev;
+    if (gap < 8000) __atomic_fetch_add(&pr->bursts, 1, __ATOMIC_RELAXED);
+    if (gap > __atomic_load_n(&pr->maxgap_us, __ATOMIC_RELAXED)) __atomic_store_n(&pr->maxgap_us, gap, __ATOMIC_RELAXED);
+  }
+  __atomic_fetch_add(&pr->count, 1, __ATOMIC_RELAXED);
+  return GST_PAD_PROBE_OK;
+}
