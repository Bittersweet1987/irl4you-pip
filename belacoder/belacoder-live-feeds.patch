+static void add_probe(GstElement *elem, const char *padname, GstPadProbeCallback cb, gpointer data) {
+  if (!elem) return;
+  GstPad *pad = gst_element_get_static_pad(elem, padname);
+  if (!pad) return;
+  gst_pad_add_probe(pad, GST_PAD_PROBE_TYPE_BUFFER | GST_PAD_PROBE_TYPE_BUFFER_LIST, cb, data, NULL);
+  gst_object_unref(pad);
+}
+
+static void add_counter(const char *label, GstElement *elem, const char *padname) {
+  if (!elem || n_probes >= STAT_PROBES) return;
+  snprintf(probes[n_probes].name, sizeof(probes[n_probes].name), "%s", label);
+  add_probe(elem, padname, probe_timed, &probes[n_probes]);
+  n_probes++;
+}
