+/*
+  sb10: how many DIFFERENT pictures leave the compositor per second (comp_new). comp_out only counts buffers: a compositor that repeats the last
+  picture still delivers 30 buffers per second, the encoder then gets (and codes for almost nothing) the same picture again and again
+  (bitrate far below the target although the network is free, the picture stutters). A sample of the luma plane (48 rows x 128 columns) is
+  hashed; a picture counts as new when the hash differs from the previous one. Needs the compositor output in normal memory (it is).
+*/
+static GstPadProbeReturn probe_comp_new(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  static guint64 prev_hash = 0;
+  static int w = 0, h = 0;
+  if (!(info->type & GST_PAD_PROBE_TYPE_BUFFER)) return GST_PAD_PROBE_OK;
+  if (!w) {
+    GstCaps *caps = gst_pad_get_current_caps(pad);
+    if (caps) {
+      GstStructure *st = gst_caps_get_structure(caps, 0);
+      int cw = 0, ch = 0;
+      if (st && gst_structure_get_int(st, "width", &cw) && gst_structure_get_int(st, "height", &ch) && cw >= 128 && ch >= 48) { w = cw; h = ch; }
+      gst_caps_unref(caps);
+    }
+    if (!w) return GST_PAD_PROBE_OK;
+  }
+  GstMapInfo m;
+  if (!gst_buffer_map(GST_PAD_PROBE_INFO_BUFFER(info), &m, GST_MAP_READ)) return GST_PAD_PROBE_OK;
+  if (m.size >= (gsize)w * h) {
+    guint64 hash = 1469598103934665603ULL;
+    for (int r = 0; r < 48; r++) {
+      const guint8 *row = m.data + (gsize)((r * h) / 48 + 5) * w;
+      for (int c = 0; c < 128; c++) hash = (hash ^ row[(c * w) / 128 + 3]) * 1099511628211ULL;
+    }
+    if (hash != prev_hash) __atomic_fetch_add(&cnt_comp_new, 1, __ATOMIC_RELAXED);
+    prev_hash = hash;
+  }
+  gst_buffer_unmap(GST_PAD_PROBE_INFO_BUFFER(info), &m);
+  return GST_PAD_PROBE_OK;
+}
+
+static GstPadProbeReturn probe_enc_out(GstPad *pad, GstPadProbeInfo *info, gpointer data) {
+  if (info->type & GST_PAD_PROBE_TYPE_BUFFER) {
+    GstBuffer *b = GST_PAD_PROBE_INFO_BUFFER(info);
+    __atomic_fetch_add(&cnt_enc_out, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&cnt_enc_bytes, (guint64)gst_buffer_get_size(b), __ATOMIC_RELAXED);
+  }
+  return GST_PAD_PROBE_OK;
+}
