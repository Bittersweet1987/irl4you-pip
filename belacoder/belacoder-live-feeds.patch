+static gboolean feed_has_element(Feed *fd, const char *name) {
+  size_t n = strlen(fd->name);
+  if (strcmp(name, fd->name) == 0) return TRUE;
+  if (strncmp(name, fd->name, n) == 0 && name[n] == '_') return TRUE;
+  for (int i = 0; i < 3; i++) {
+    if (fd->extra[i] && strcmp(name, fd->extra[i]) == 0) return TRUE;
+  }
+  return FALSE;
+}
+
+static Feed *feed_of_element_name(const char *name) {
+  for (unsigned i = 0; i < sizeof(align_feeds) / sizeof(align_feeds[0]); i++) {
+    Feed *fd = &align_feeds[i];
+    if (fd->dynamic && feed_has_element(fd, name)) return fd;
+  }
+  return NULL;
+}
+
+static Feed *feed_by_name(const char *name) {
+  for (unsigned i = 0; i < sizeof(align_feeds) / sizeof(align_feeds[0]); i++) {
+    if (align_feeds[i].dynamic && strcmp(align_feeds[i].name, name) == 0) return &align_feeds[i];
+  }
+  return NULL;
