+/* Mindestanteil (IRL4YOU): Jeder geeignete Weg (innerhalb des Laufzeitabstands, mit freiem Fenster) bekommt mindestens
+   MIN_SHARE_PCT Prozent der Pakete, damit auch der schwaechere Weg "warm" bleibt und bei Ausfall des besten nicht erst
+   anlaufen muss. Gemessen wird in einem gleitenden Fenster von etwa SHARE_EPOCH Paketen. Ein Weg ausserhalb des
+   Laufzeitabstands oder ohne freies Fenster bekommt keinen Mindestanteil. 0 = aus (Standard). */
+static int min_share_pct = 0;     /* nur bei Verteilung "alle" (Umgebungsvariable SRTLA_MIN_SHARE_PCT, vom Sendedienst gesetzt) */
+#define SHARE_EPOCH 1000
+#define SHARE_MIN_TOTAL 100
