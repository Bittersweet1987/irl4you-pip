[Unit]
Description=IRL4YOU BOX WLAN-Treiber für USB-Sticks mit AIC8800D80 (holt und baut den Treiber bei Bedarf)
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pipbox/pipbox-wlandriver.py auto
TimeoutStartSec=25min
Nice=10
CapabilityBoundingSet=CAP_SYS_MODULE CAP_SYSLOG CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/lib/modules /lib/firmware /etc/modprobe.d /run
StateDirectory=pipbox-wlandriver
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectClock=yes
DeviceAllow=char-usb_device rw
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
