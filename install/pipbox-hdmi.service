[Unit]
Description=IRL4YOU BOX HDMI-Eingang als Kamera
After=network-online.target nginx.service

[Service]
ExecStart=/usr/bin/python3 -u /opt/pipbox/hdmi_daemon.py --state /var/lib/pipbox
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
